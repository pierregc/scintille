# Copy to /srv/scintille/.env on the VPS (chmod 600, owner deploy). Never commit the real file.
SCINTILLE_LOG_DRIVER=journald
POSTGRES_PASSWORD=
SCINTILLE_LAKE_URI=
SCINTILLE_LAKE_WAREHOUSE=
SCINTILLE_LAKE_TOKEN=
SCINTILLE_LIVE_BUCKET=scintille-live
# Seconds without a file before a source is delayed, then offline (defaults 120 and 600).
# SCINTILLE_SOURCE_DELAYED_AFTER=120
# SCINTILLE_SOURCE_OFFLINE_AFTER=600
SCINTILLE_R2_ENDPOINT=
SCINTILLE_R2_BUCKET=
SCINTILLE_R2_ACCESS_KEY_ID=
SCINTILLE_R2_SECRET_ACCESS_KEY=
SCINTILLE_EUMETSAT_CONSUMER_KEY=
SCINTILLE_EUMETSAT_CONSUMER_SECRET=
SCINTILLE_ALERT_WEBHOOK=
# Healthchecks.io ping URLs (docs/operations.md); unset means no ping.
SCINTILLE_HEALTHCHECK_URL=
SCINTILLE_HEALTHCHECK_LIVE_URL=
# Uncomment to run the cloud texture service.
# COMPOSE_PROFILES=clouds
