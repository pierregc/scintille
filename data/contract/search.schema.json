{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scintille:contract:search",
  "title": "StormsNearby",
  "description": "GET /api/storms/nearby (ADR 0027): published storms whose observed interval meets the window and whose path comes within the radius, best first. Depends on the URL only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query", "catalog", "distance", "total", "storms"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "query": {
      "$ref": "#/$defs/NearbyQuery"
    },
    "catalog": {
      "$ref": "#/$defs/SearchCatalog"
    },
    "distance": {
      "description": "Great-circle distance to the arcs joining the storm's hourly centroids, minus the radius of a disc with its largest hourly area, at least 0, rounded to 10 km.",
      "const": "path-minus-radius"
    },
    "total": {
      "description": "Matching storms before the limit.",
      "type": "integer",
      "minimum": 0
    },
    "storms": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/NearbyStorm"
      }
    }
  },
  "$defs": {
    "NearbyQuery": {
      "description": "The query as answered: the point rounded to 0.1°, the window ending at the request time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon", "hours", "km", "limit", "window_start", "window_end"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "km": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "window_start": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "window_end": {
          "description": "The request time.",
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      }
    },
    "SearchCatalog": {
      "description": "What the search index holds: published storms of min_level and above, kept retention_days.",
      "type": "object",
      "additionalProperties": false,
      "required": ["min_level", "retention_days", "published_at", "last_observation_time", "stale", "complete"],
      "properties": {
        "min_level": {
          "type": "integer",
          "minimum": 1
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "published_at": {
          "description": "Last sync of the index.",
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "last_observation_time": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "description": "The last observation is more than 3 hours old.",
          "type": "boolean"
        },
        "complete": {
          "description": "False while some published storms wait to be indexed.",
          "type": "boolean"
        }
      }
    },
    "NearbyStorm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storm", "distance_km", "score"],
      "properties": {
        "storm": {
          "$ref": "storm.schema.json#/$defs/StormSummary"
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "score": {
          "description": "ADR 0009 score: square root of flashes times peak rate.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "SearchError": {
      "description": "Refused or failed search: invalid (400), too-broad (422, more candidates than one answer reads), unavailable (503).",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "errors"],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "status": {
          "enum": ["invalid", "too-broad", "unavailable"]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VisitorLocation": {
      "description": "GET /api/location: the city of the visitor's IP address according to Cloudflare, rounded to 0.1°. Never stored or cached; no time zone, postal code or address.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "source", "lat", "lon", "city", "region", "country_code"],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "status": {
          "description": "unavailable when the city or its coordinates are unknown; a country alone is not a location.",
          "enum": ["approximate", "unavailable"]
        },
        "source": {
          "const": "ip"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "lon": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
