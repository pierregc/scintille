{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scintille:contract:chunk",
  "title": "LiveChunk",
  "description": "Decoded content of one live chunk: the display fields of its flashes, as columns.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "start", "columns"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "start": {
      "description": "Start of the ingest window; event offsets are relative to it.",
      "$ref": "common.schema.json#/$defs/UtcTimestamp"
    },
    "columns": { "$ref": "#/$defs/ChunkColumns" }
  },
  "$defs": {
    "ChunkColumns": {
      "description": "Arrays of equal length, sorted by event time. Binary column order is the property order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_offset_ms",
        "lat",
        "lon",
        "area_km2",
        "duration_ms",
        "intensity",
        "source",
        "quality"
      ],
      "properties": {
        "event_offset_ms": {
          "description": "event_time minus start, milliseconds; usually negative (satellite latency).",
          "type": "array",
          "items": { "type": "integer", "minimum": -2147483647, "maximum": 2147483647 },
          "x-binary": { "dtype": "int32", "scale": 1 }
        },
        "lat": {
          "description": "Latitude, degrees north (resolution about 300 m).",
          "type": "array",
          "items": { "type": "number", "minimum": -90, "maximum": 90 },
          "x-binary": { "dtype": "int16", "scale": 0.0027466658528397473 }
        },
        "lon": {
          "description": "Longitude, degrees east (resolution about 600 m).",
          "type": "array",
          "items": { "type": "number", "minimum": -180, "maximum": 180 },
          "x-binary": { "dtype": "int16", "scale": 0.005493331705679495 }
        },
        "area_km2": {
          "description": "Flash area, square kilometres, clamped to 65535.",
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 65535 },
          "x-binary": { "dtype": "uint16", "scale": 1 }
        },
        "duration_ms": {
          "description": "Flash duration, milliseconds, clamped to 65535.",
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 65535 },
          "x-binary": { "dtype": "uint16", "scale": 1 }
        },
        "intensity": {
          "description": "Normalized intensity 0-1 (resolution 1/255).",
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "x-binary": { "dtype": "uint8", "scale": 0.00392156862745098 }
        },
        "source": {
          "description": "Source; in binary, its index in Source.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Source" },
          "x-binary": { "dtype": "uint8", "scale": 1 }
        },
        "quality": {
          "description": "Quality bitmask: bit i is set when QualityFlag i applies.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "x-binary": { "dtype": "uint8", "scale": 1 }
        }
      }
    }
  }
}
