<details class="suggestions" data-storm-suggestions hidden>
	<summary>
		<svg width="12" height="14" viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true"
			><path d="M7 1 2.5 8H6l-1 5 4.5-7H6z"></path></svg
		>
		Explore storms
	</summary>
	<div class="panel">
		<p role="status" data-catalog-status></p>
		<ul aria-label="Available storm replays" data-storm-cards></ul>
		<p class="note">Levels describe measured electrical activity. Replay bounds may include nearby flashes.</p>
		<button type="button" data-catalog-retry>Refresh storms</button>
	</div>
</details>

<style>
	.suggestions { position: fixed; top: calc(var(--gut) + 62px); left: var(--gut); z-index: 3; width: min(25rem, calc(100vw - 2 * var(--gut))); }
	.suggestions[open]::before {
		position: fixed;
		inset: 0 auto 0 0;
		z-index: -1;
		width: min(36rem, 100vw);
		pointer-events: none;
		content: '';
		background: linear-gradient(90deg, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.28) 55%, transparent);
	}
	summary, [data-catalog-retry] { color: var(--dim); font: 300 10px/1.5 var(--mono); letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; }
	summary { display: inline-flex; gap: 10px; align-items: center; min-height: 32px; color: var(--soft); font-size: 12px; letter-spacing: 0.2em; list-style: none; }
	summary::-webkit-details-marker { display: none; }
	summary:hover, .suggestions[open] > summary { color: var(--ink); }
	.panel { margin-top: 10px; max-height: calc(100svh - 300px); overflow-y: auto; overscroll-behavior: contain; scrollbar-color: var(--hair) transparent; scrollbar-width: thin; }
	p { margin: 0 0 16px; color: var(--dim); font: 300 11px/1.6 var(--sans); }
	ul { display: grid; gap: 10px; padding: 0; margin: 0 0 16px; list-style: none; }
	[data-storm-cards] :global(button) { display: grid; gap: 5px; width: 100%; min-height: 44px; padding: 10px 0 10px 16px; color: var(--soft); text-align: left; cursor: pointer; background: none; border: 0; border-left: 1px solid var(--hair); transition: color 0.4s ease, border-color 0.4s ease; }
	[data-storm-cards] :global(button:hover) { color: var(--ink); border-left-color: var(--soft); }
	[data-storm-cards] :global(em) { color: var(--soft); font: 300 10.5px/1.5 var(--mono); font-style: normal; letter-spacing: 0.18em; text-transform: uppercase; }
	[data-storm-cards] :global(strong) { color: inherit; font: 200 21px/1.3 var(--sans); }
	[data-storm-cards] :global(span) { color: var(--dim); font: 300 11.5px/1.5 var(--sans); }
	.note { font-size: 10.5px; }
	[data-catalog-retry] { padding: 8px 0; background: none; border: 0; }
	[data-catalog-retry]:hover { color: var(--soft); }
	:focus-visible, [data-storm-cards] :global(button:focus-visible) { outline: 1px solid var(--soft); outline-offset: 3px; }
	[hidden] { display: none !important; }
	:global(.hud:has([data-storm-suggestions][open]) :is([data-share-tools], [data-replay-status])) { visibility: hidden; }
	@media (max-width: 640px) {
		.suggestions { top: calc(var(--gut) + 96px); width: min(22rem, calc(100vw - 2 * var(--gut))); }
		.suggestions[open]::before { inset: 0; width: auto; background: linear-gradient(180deg, rgb(0 0 0 / 0.62), rgb(0 0 0 / 0.4) 60%, transparent); }
		.panel { max-height: calc(100svh - 240px); }
		:global(.hud:has([data-storm-suggestions][open]) [data-layers]) { visibility: hidden; }
	}
	@media (prefers-reduced-motion: reduce) {
		[data-storm-cards] :global(button) { transition: none; }
	}
</style>

<script>
	import type { GlobeApp } from '../globe/app';
	import { GLOBE_GONE, GLOBE_READY } from '../globe/island';
	import { CATALOG_LIMITS, loadSuggestions, stormDay, stormFigure } from '../globe/replay/catalog';

	const root = document.querySelector<HTMLDetailsElement>('[data-storm-suggestions]');
	if (root) {
		const status = root.querySelector<HTMLElement>('[data-catalog-status]');
		const list = root.querySelector<HTMLElement>('[data-storm-cards]');
		const retry = root.querySelector<HTMLButtonElement>('[data-catalog-retry]');
		let app: GlobeApp | undefined;
		let request: AbortController | undefined;
		let loaded = false;
		const setStatus = (text: string) => { if (status) status.textContent = text; };

		const load = async () => {
			if (!app || !list) return;
			request?.abort();
			const current = new AbortController();
			request = current;
			loaded = false;
			list.replaceChildren();
			setStatus('Loading available storms…');
			try {
				const result = await loadSuggestions(app.replay.baseUrl, current.signal);
				if (current.signal.aborted) return;
				loaded = true;
				const date = new Date(result.publishedAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
				const stale = Date.now() - result.publishedAt > CATALOG_LIMITS.staleMs;
				setStatus(!result.cards.length ? 'No published storm replays are available yet.' :
					`Catalog published ${date}.${stale ? ' Recent storms may be missing.' : ''}${result.partial ? ' Only part of the catalog could be loaded.' : ''}`);
				for (const card of result.cards) {
					const { storm, reason } = card;
					const item = document.createElement('li');
					const button = document.createElement('button');
					button.type = 'button';
					if (reason) {
						const why = document.createElement('em');
						why.textContent = reason;
						button.append(why);
					}
					const title = document.createElement('strong');
					title.textContent = storm.label;
					const facts = document.createElement('span');
					facts.textContent = `${stormDay(storm)} · ${stormFigure(card)}`;
					button.append(title, facts);
					button.addEventListener('click', async () => {
						const currentApp = app;
						if (!currentApp) return;
						setStatus(`Opening ${storm.label}…`);
						const opened = await currentApp.replay.open(storm.slug);
						if (app !== currentApp) return;
						if (opened) { root.open = false; document.querySelector<HTMLButtonElement>('[data-play]')?.focus(); }
						else if (currentApp.replay.state.error) setStatus(currentApp.replay.state.error);
					});
					item.append(button);
					list.append(item);
				}
			} catch {
				if (!current.signal.aborted) setStatus('The storm catalog is unavailable. Refresh to try again; live viewing remains available.');
			}
		};
		root.addEventListener('toggle', () => {
			if (!root.open) return;
			const info = document.querySelector<HTMLDetailsElement>('[data-info]');
			if (info) info.open = false;
			if (!loaded) void load();
		});
		root.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') { root.open = false; root.querySelector('summary')?.focus(); }
		});
		retry?.addEventListener('click', () => { void load(); });
		window.addEventListener(GLOBE_READY, (event) => {
			app = (event as CustomEvent<GlobeApp>).detail;
			root.hidden = false;
			if (root.open) void load();
		});
		window.addEventListener(GLOBE_GONE, () => {
			request?.abort(); app = undefined; loaded = false; root.hidden = true; list?.replaceChildren();
		});
	}
</script>
