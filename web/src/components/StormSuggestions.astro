---
import { STORM_SEARCH_REGION_VALUES } from '../contract/types';
---
<details class="suggestions" data-storm-suggestions hidden>
	<summary>Explore storms</summary>
	<section class="panel" aria-label="Storm catalog browser">
		<div class="heading"><h2>Explore storms</h2><button type="button" data-browser-close>Close</button></div>
		<form data-storm-search>
			<label>Place, country or date<input name="q" type="search" maxlength="120" placeholder="São Paulo, France, 2026-10" /></label>
			<p class="note">Complete words · UTC dates: YYYY-MM-DD or YYYY-MM</p>
			<div class="filters">
				<label>Storm start<select name="period"><option value="">Any time</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="custom">Custom dates</option></select></label>
				<label>Region<select name="region"><option value="">All regions</option>{STORM_SEARCH_REGION_VALUES.map(region => <option value={region}>{region === 'unassigned' ? 'Offshore / unassigned' : region.replace(/-/g, ' ').replace(/^./, c => c.toUpperCase())}</option>)}</select></label>
				<label>Activity<select name="level"><option value="">All levels</option><option value="1">1 · Light</option><option value="2">2 · Moderate</option><option value="3">3 · Strong</option><option value="4">4 · Intense</option><option value="5">5 · Exceptional</option></select></label>
			</div>
			<div class="dates" data-custom-dates hidden><label>From (UTC)<input name="from" type="date" /></label><label>Until (UTC, excluded)<input name="to" type="date" /></label></div>
			<div class="actions"><button type="submit">Search</button><button type="reset">Clear filters</button></div>
		</form>
		<p role="status" aria-live="polite" data-catalog-status></p>
		<p class="note" data-query-dates></p>
		<ol aria-label="Published storm replays" data-storm-cards></ol>
		<div class="actions"><button type="button" data-browser-previous disabled>Previous</button><button type="button" data-browser-next disabled>Next</button><button type="button" data-catalog-retry>Refresh</button></div>
		<p class="note">Numbers mark this page’s first named locations. Rotate the globe to see the far side. Grouped markers focus their rows.</p>
		<p class="note">Levels describe measured electrical activity. Replay bounds may include nearby flashes.</p>
	</section>
</details>
<style>
	.suggestions { position: fixed; top: calc(var(--gut) + 140px); left: var(--gut); z-index: 3; }
	summary, button { color: var(--soft); font: 300 10px/1.5 var(--mono); letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
	summary { min-height: 44px; }
	.suggestions[open] { inset: 0 auto 0 0; width: 360px; }
	.suggestions[open] summary { display: none; }
	.panel { box-sizing: border-box; height: 100%; padding: 24px 20px; background: rgb(3 8 16 / .95); border-right: 1px solid var(--hair); overflow-y: auto; overscroll-behavior: contain; }
	.heading, .actions { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
	h2 { color: var(--ink); font: 300 22px/1.4 var(--sans); margin: 0 0 20px; }
	p { color: var(--soft); font: 300 12px/1.6 var(--sans); }
	label { display: grid; gap: 6px; color: var(--soft); font: 300 11px/1.5 var(--sans); }
	input, select { box-sizing: border-box; min-width: 0; width: 100%; min-height: 44px; color: var(--ink); background: #0b131d; border: 1px solid var(--hair); border-radius: 0; padding: 8px; font: 300 12px var(--sans); }
	.filters { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
	.dates { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
	button { background: none; border: 0; min-height: 44px; padding: 8px 0; }
	button:disabled { opacity: .4; cursor: default; }
	ol { padding: 0; list-style: none; }
	[data-storm-cards] :global(li) { padding: 14px 0; border-top: 1px solid var(--hair); }
	[data-storm-cards] :global(strong) { color: var(--ink); font: 300 16px/1.5 var(--sans); }
	[data-storm-cards] :global(p) { margin: 4px 0; }
	[data-storm-cards] :global(a) { color: var(--soft); margin-left: 16px; font: 12px var(--sans); }
	.note { color: var(--dim); font-size: 11px; }
	:focus-visible, :global([data-storm-cards] button:focus-visible) { outline: 1px solid var(--soft); outline-offset: 3px; }
	[hidden] { display: none !important; }
	@media (max-width: 640px) {
		.suggestions { top: calc(var(--gut) + 62px); }
		.suggestions[open] { inset: auto 0 0; width: 100%; height: 45dvh; }
		.panel { padding: 14px 16px; border-top: 1px solid var(--hair); }
		h2 { margin-bottom: 10px; font-size: 20px; }
		.filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
</style>
<script>
	import { mountStormBrowser } from './hud/storm-browser';
	const root = document.querySelector<HTMLDetailsElement>('[data-storm-suggestions]');
	if (root) mountStormBrowser(root);
</script>
