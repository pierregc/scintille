<details class="debug" data-debug open hidden>
	<summary><span class="cap">Debug</span><i aria-hidden="true"></i></summary>
	<div class="body">
		<p class="rates" data-debug-rates></p>
		<p class="head"><span>UTC</span><span>Src</span><span>Int</span><span>km²</span><span>ms</span></p>
		<ol class="flashes" data-debug-flashes></ol>
	</div>
</details>

<style>
	.debug {
		position: fixed;
		right: var(--gut);
		bottom: calc(var(--gut) + 120px);
		display: grid;
		justify-items: end;
		color: var(--soft);
		font: 300 10px/1.6 var(--mono);
		font-variant-numeric: tabular-nums;
		text-align: right;
		pointer-events: none;
	}
	.debug > summary {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		min-height: 24px;
		color: var(--dim);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		list-style: none;
		cursor: pointer;
		pointer-events: auto;
	}
	.debug > summary::-webkit-details-marker {
		display: none;
	}
	.debug > summary .cap {
		color: inherit;
	}
	.debug > summary i {
		width: 5px;
		height: 5px;
		border: solid currentcolor;
		border-width: 0 1px 1px 0;
		transform: translateY(-2px) rotate(45deg);
	}
	.debug[open] > summary i {
		transform: translateY(1px) rotate(-135deg);
	}
	.debug > summary:hover,
	.debug[open] > summary {
		color: var(--soft);
	}
	.rates {
		margin: 4px 0 8px;
		color: var(--soft);
	}
	.head,
	.flashes :global(li) {
		display: grid;
		grid-template-columns: 8ch 6ch 4ch 5ch 4ch;
		gap: 1.5ch;
		justify-items: end;
		white-space: nowrap;
	}
	.head {
		margin: 0;
		color: var(--dim);
	}
	.flashes {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.flashes :global(li) {
		color: var(--dim);
	}
	.flashes :global(li.new) {
		animation: arrive 1.2s ease-out;
	}
	@keyframes arrive {
		from {
			color: var(--glow);
		}
	}
	@media (max-width: 640px) {
		.debug {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.flashes :global(li.new) {
			animation: none;
		}
	}
</style>

<script>
	import { BUILD } from '../version';
	import type { GlobeApp } from '../globe/app';
	import { GLOBE_GONE, GLOBE_READY } from '../globe/island';
	import { debugEnabled, type FlashRow, playedFlashes, shortSourceLabel, sourceStats } from './debug/stats';

	const ROWS = 10;
	const panel = document.querySelector<HTMLDetailsElement>('[data-debug]');
	if (panel && debugEnabled(location.search, import.meta.env.DEV || BUILD.pr !== null)) {
		panel.hidden = false;
		const rates = panel.querySelector<HTMLElement>('[data-debug-rates]');
		const list = panel.querySelector<HTMLOListElement>('[data-debug-flashes]');
		const rows = new Map<string, HTMLLIElement>();
		const key = (f: FlashRow) => `${f.id}/${f.time}/${f.lat}/${f.lon}`;
		let app: GlobeApp | undefined;
		let topTime = Number.NEGATIVE_INFINITY;

		const showRates = () => {
			if (!app || !rates) return;
			const { ring, delays } = app.debug;
			rates.textContent = sourceStats(ring, delays(), app.clock.time())
				.map((s) => `${s.label} ${s.lastMinute.toLocaleString('en')}/min`)
				.join(' · ');
		};

		const row = (f: FlashRow, fresh: boolean) => {
			const li = document.createElement('li');
			if (fresh) li.className = 'new';
			for (const text of [
				new Date(f.time).toISOString().slice(11, 19),
				shortSourceLabel(f.source),
				f.intensity.toFixed(2),
				String(Math.round(f.areaKm2)),
				String(Math.round(f.durationMs)),
			]) {
				const span = document.createElement('span');
				span.textContent = text;
				li.append(span);
			}
			return li;
		};

		const showFlashes = () => {
			if (!app || !list || !panel.open || document.hidden) return;
			const { ring, delays } = app.debug;
			const flashes = playedFlashes(ring, delays(), app.clock.time(), ROWS);
			const next = flashes.map((f) => rows.get(key(f)) ?? row(f, f.time > topTime && topTime > 0));
			rows.clear();
			flashes.forEach((f, i) => rows.set(key(f), next[i]));
			topTime = flashes[0]?.time ?? Number.NEGATIVE_INFINITY;
			if (next.some((li, i) => list.children[i] !== li) || list.children.length !== next.length) {
				list.replaceChildren(...next);
			}
		};

		setInterval(() => { if (panel.open && !document.hidden) showRates(); }, 1000);
		const frame = () => {
			showFlashes();
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
		panel.addEventListener('toggle', () => {
			showRates();
			showFlashes();
		});

		window.addEventListener(GLOBE_READY, (event) => {
			app = (event as CustomEvent<GlobeApp>).detail;
			showRates();
		});
		window.addEventListener(GLOBE_GONE, () => {
			app = undefined;
		});
	}
</script>
