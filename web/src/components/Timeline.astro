<section class="strip" aria-label="Playback" data-strip hidden>
	<div class="ctl">
		<button class="tx live-only" type="button" data-travel>
			<svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"
				><path d="M2.5 7a4.5 4.5 0 1 0 1.3-3.2M2.5 1.5v2.8h2.8"></path><path d="M7 4.5V7l1.8 1.2"></path></svg
			>
			Travel in time
		</button>
		<button class="tx replay-only" type="button" data-play aria-label="Pause">
			<svg class="pause" width="9" height="11" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"
				><rect x="1.5" y="1" width="1.4" height="10"></rect><rect x="7.1" y="1" width="1.4" height="10"></rect></svg
			>
			<svg class="play" width="9" height="11" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M1.5 1v10l8-5z"></path></svg>
		</button>
		<div class="speed replay-only" role="radiogroup" aria-label="Playback speed" data-speeds></div>
		<label class="when replay-only">
			<span class="sr">Date</span>
			<input type="date" data-day />
		</label>
	</div>
	<div
		class="scale replay-only"
		role="slider"
		tabindex="0"
		aria-label="Time"
		aria-valuemin="0"
		aria-valuemax="1439"
		aria-valuenow="0"
		data-scale
	>
		<div class="ticks" data-ticks></div>
		<div data-labels></div>
		<div class="head" data-head><b data-head-time></b></div>
	</div>
	<div class="live-only spacer" aria-hidden="true"></div>
</section>

<style>
	:global(:where([data-strip] button)) {
		padding: 0;
		color: inherit;
		font: inherit;
		text-shadow: inherit;
		cursor: pointer;
		background: none;
		border: 0;
		transition: color 0.6s ease;
	}
	:global(:where([data-strip] :focus-visible)) {
		outline: 1px solid var(--soft);
		outline-offset: 5px;
	}
	.strip {
		position: fixed;
		right: var(--gut);
		bottom: var(--gut);
		left: var(--gut);
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 32px;
		align-items: end;
	}
	:global(.hud[data-mode='live']) .replay-only,
	:global(.hud[data-mode='replay']) .live-only {
		display: none !important;
	}
	.ctl {
		display: flex;
		gap: 22px;
		align-items: center;
	}
	.tx {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		min-height: 24px;
		color: var(--soft);
		font: 300 10.5px/1 var(--mono);
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
	.tx:hover {
		color: var(--ink);
	}
	[data-play] .play,
	[data-play][data-paused] .pause {
		display: none;
	}
	[data-play][data-paused] .play {
		display: block;
	}
	.speed {
		display: flex;
		gap: 14px;
	}
	.speed :global(button) {
		min-height: 24px;
		padding-bottom: 4px;
		color: var(--dim);
		font: 300 11px/1 var(--mono);
		border-bottom: 1px solid transparent;
	}
	.speed :global(button[aria-checked='true']) {
		color: var(--ink);
		border-bottom-color: var(--soft);
	}
	.when input {
		padding: 0 0 4px;
		color: var(--soft);
		font: 300 11px/1 var(--mono);
		letter-spacing: 0.08em;
		color-scheme: dark;
		background: none;
		border: 0;
		border-bottom: 1px solid var(--hair);
	}
	.when input:hover {
		color: var(--ink);
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.scale {
		position: relative;
		height: 26px;
		cursor: ew-resize;
		touch-action: none;
	}
	.scale .ticks {
		position: absolute;
		right: 0;
		bottom: 8px;
		left: 0;
		height: 6px;
	}
	.scale .ticks :global(i) {
		position: absolute;
		width: 1px;
		height: 100%;
		background: var(--hair);
	}
	.scale :global(.lbl) {
		position: absolute;
		bottom: -8px;
		color: var(--dim);
		font: 300 9px/1 var(--mono);
		letter-spacing: 0.1em;
		transform: translateX(-50%);
	}
	.scale :global(.lbl.end) {
		transform: translateX(-100%);
	}
	.scale .head {
		position: absolute;
		bottom: 4px;
		width: 1px;
		height: 18px;
		background: var(--glow);
		box-shadow: 0 0 8px var(--glow);
	}
	.scale .head b {
		position: absolute;
		top: -14px;
		left: 8px;
		color: var(--glow);
		font: 300 10px/1 var(--mono);
		white-space: nowrap;
	}
	.scale .head[data-flip] b {
		right: 8px;
		left: auto;
	}
	@media (max-width: 640px) {
		.strip {
			grid-template-columns: 1fr;
			grid-template-areas: 'scale' 'ctl';
			gap: 26px 12px;
		}
		.scale {
			grid-area: scale;
		}
		.ctl {
			grid-area: ctl;
			flex-wrap: wrap;
			gap: 14px;
		}
		.speed {
			gap: 10px;
		}
		.spacer {
			display: none;
		}
	}
</style>

<script>
	import type { GlobeApp } from '../globe/app';
	import { GLOBE_GONE, GLOBE_READY } from '../globe/island';
	import { formatTime, zoneLabel } from './hud/format';
	import {
		DEFAULT_SPEED,
		dateInputValue,
		dayStart,
		keyStep,
		parseDateInput,
		REPLAY_LOOKBACK_MS,
		scaleMarks,
		scaleWindow,
		SPEEDS,
		speedLabel,
		timeAtFraction,
		windowFraction,
		type ScaleWindow,
	} from './hud/timeline';

	const strip = document.querySelector<HTMLElement>('[data-strip]');
	if (strip) {
		const $ = <T extends HTMLElement>(selector: string) => strip.querySelector<T>(selector);
		const play = $<HTMLButtonElement>('[data-play]');
		const speeds = $('[data-speeds]');
		const day = $<HTMLInputElement>('[data-day]');
		const scale = $('[data-scale]');
		const head = $('[data-head]');
		const headTime = $('[data-head-time]');
		const ticks = $('[data-ticks]');
		const labels = $('[data-labels]');
		let app: GlobeApp | undefined;
		let drag: ScaleWindow | undefined;
		let layout = '';

		const speedButtons = SPEEDS.map((speed) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.setAttribute('role', 'radio');
			button.textContent = speedLabel(speed);
			button.addEventListener('click', () => {
				if (app?.clock.mode === 'replay') app.clock.setSpeed(speed);
				tick();
			});
			speeds?.append(button);
			return { speed, button };
		});

		const now = () => app?.clock.time() ?? Date.now();
		const wall = () => app?.clock.wallTime() ?? Date.now();
		const view = () => drag ?? scaleWindow(now(), wall());
		const seek = (time: number) => {
			if (app?.clock.mode !== 'replay') return;
			app.clock.seek(time);
			tick();
		};
		const pct = (at: number) => `${(at * 100).toFixed(3)}%`;

		function draw(w: ScaleWindow) {
			const key = `${Math.floor(w.start / 60_000)}:${Math.floor(w.end / 60_000)}`;
			if (key === layout) return;
			layout = key;
			const marks = scaleMarks(w);
			if (ticks) ticks.innerHTML = marks.ticks.map((at) => `<i style="left:${pct(at)}"></i>`).join('');
			if (labels) labels.innerHTML = marks.labels.map(({ at, text }) => `<span class="lbl${at === 1 ? ' end' : ''}" style="left:${pct(at)}">${text}</span>`).join('');
		}

		function tick() {
			const clock = app?.clock;
			if (!clock) return;
			const t = clock.time();
			const w = view();
			draw(w);
			const fraction = windowFraction(w, t);
			if (head) {
				head.style.left = pct(fraction);
				head.toggleAttribute('data-flip', fraction > 0.85);
			}
			const label = formatTime(t).slice(0, 5);
			if (headTime && headTime.textContent !== label) headTime.textContent = label;
			scale?.setAttribute('aria-valuenow', String(Math.floor(fraction * 1440)));
			scale?.setAttribute('aria-valuetext', `${label} ${zoneLabel(undefined, t)}`);
			const iso = dateInputValue(t);
			if (day && document.activeElement !== day && day.value !== iso) day.value = iso;
			const today = dateInputValue(wall());
			if (day && day.max !== today) day.max = today;
			if (play) {
				play.toggleAttribute('data-paused', !clock.playing);
				play.setAttribute('aria-label', clock.playing ? 'Pause' : 'Play');
			}
			for (const { speed, button } of speedButtons) button.setAttribute('aria-checked', String(clock.speed === speed));
		}
		setInterval(tick, 100);

		window.addEventListener(GLOBE_READY, (event) => {
			app = (event as CustomEvent<GlobeApp>).detail;
			strip.hidden = false;
			tick();
		});
		window.addEventListener(GLOBE_GONE, () => {
			app = undefined;
			strip.hidden = true;
		});

		$('[data-travel]')?.addEventListener('click', () => {
			if (!app) return;
			const slug = new URLSearchParams(location.search).get('storm');
			if (slug) {
				void app.replay.open(slug);
				return;
			}
			app.clock.replay(Math.max(Date.now() - REPLAY_LOOKBACK_MS, app.dataStart() ?? 0), DEFAULT_SPEED);
			tick();
			play?.focus();
		});
		const togglePlay = () => {
			const clock = app?.clock;
			if (clock?.mode !== 'replay') return;
			if (clock.playing) clock.pause();
			else clock.play();
			tick();
		};
		play?.addEventListener('click', togglePlay);
		day?.addEventListener('change', () => {
			const start = parseDateInput(day.value);
			if (start === null) return;
			const target = start + (now() - dayStart(now()));
			seek(target < wall() ? target : wall() - REPLAY_LOOKBACK_MS);
		});

		const seekToPointer = (event: PointerEvent) => {
			if (!scale) return;
			const rect = scale.getBoundingClientRect();
			seek(timeAtFraction(view(), (event.clientX - rect.left) / rect.width));
		};
		scale?.addEventListener('pointerdown', (event) => {
			scale.setPointerCapture(event.pointerId);
			drag = scaleWindow(now(), wall());
			seekToPointer(event);
		});
		scale?.addEventListener('lostpointercapture', () => {
			drag = undefined;
			tick();
		});
		scale?.addEventListener('pointermove', (event) => {
			if (scale.hasPointerCapture(event.pointerId)) seekToPointer(event);
		});
		scale?.addEventListener('keydown', (event) => {
			const w = view();
			const end = timeAtFraction(w, 1);
			let target: number | undefined;
			if (event.key === ' ') {
				event.preventDefault();
				return togglePlay();
			}
			if (event.key === 'Home') target = w.start;
			else if (event.key === 'End') target = end;
			else if (keyStep(event.key, event.shiftKey)) target = Math.min(Math.max(now() + keyStep(event.key, event.shiftKey), w.start), end);
			if (target === undefined) return;
			event.preventDefault();
			seek(target);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== ' ' || event.repeat) return;
			const target = event.target as HTMLElement | null;
			if (target?.closest('button, input, summary, a, [role="slider"]')) return;
			if (app?.clock.mode !== 'replay') return;
			event.preventDefault();
			togglePlay();
		});
	}
</script>
