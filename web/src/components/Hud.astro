---
import '@fontsource/ibm-plex-sans/latin-200.css';
import '@fontsource/ibm-plex-sans/latin-300.css';
import '@fontsource/ibm-plex-mono/latin-200.css';
import '@fontsource/ibm-plex-mono/latin-300.css';
import Timeline from './Timeline.astro';
import StormSuggestions from './StormSuggestions.astro';
---

<main class="hud" data-hud data-mode="live">
	<div class="frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

	<header class="id">
		<h1>Scintille</h1>
		<p class="tag cap">Lightning · seen from orbit</p>
	</header>

	<div class="corner">
		<a class="cap" href="/methodology">Methodology</a>
	</div>

	<StormSuggestions />

	<section class="clock" aria-label="Time">
		<p class="t"><time data-time>--:--:--</time><span class="side"><small data-zone></small><span class="d" data-date></span></span></p>
		<div class="state">
			<span class="pulse" aria-hidden="true"></span>
			<span class="cap" data-state role="status">Live</span>
			<span class="cap rate" data-rate hidden></span>
			<button class="golive" type="button" data-live>Back to live</button>
		</div>
		<ul class="sources" aria-label="Sources" data-sources hidden></ul>
		<p class="note" data-sources-note hidden></p>
	</section>

	<p class="stale cap" role="status" data-stale hidden><span data-stale-text></span><span class="dots" aria-hidden="true"><i>.</i><i>.</i><i>.</i></span></p>
	<div class="storm" data-storm-panel>
		<p class="replay-status" role="status" data-replay-status hidden></p>
		<div class="tools" data-storm-tools hidden>
			<button type="button" aria-pressed="false" data-follow>Follow</button>
			<button type="button" aria-pressed="false" data-horizon>Horizon</button>
			<button type="button" data-globe hidden>Globe</button>
			<button type="button" data-restart hidden>Replay from start</button>
		</div>
	</div>

	<div class="layers" data-layers hidden>
		<div class="group" role="group" aria-label="Layers">
			<button class="sw" type="button" aria-pressed="true" data-clouds><span class="cap">Clouds</span><i aria-hidden="true"></i></button>
			<button class="sw" type="button" aria-pressed="false" data-sound hidden><span class="cap">Sound</span><i aria-hidden="true"></i></button>
			<div class="mix" data-mix hidden>
				<label class="level"><span class="cap">Music</span><input type="range" min="0" max="100" step="1" value="60" data-level="music" /></label>
				<label class="level"><span class="cap">Flashes</span><input type="range" min="0" max="100" step="1" value="80" data-level="flashes" /></label>
			</div>
		</div>
		<div class="afterglow" data-afterglow>
			<span class="cap" id="afterglow-label">Afterglow</span>
			<div class="opts" role="radiogroup" aria-labelledby="afterglow-label" data-display></div>
		</div>
	</div>

	<Timeline />
</main>

<style>
	.storm {
		position: fixed;
		top: calc(var(--gut) + 100px);
		left: var(--gut);
		display: flex;
		flex-direction: column;
		max-width: min(24rem, calc(100vw - 2 * var(--gut)));
		pointer-events: none;
	}
	.replay-status { color: var(--soft); font: 300 12px/1.6 var(--sans); white-space: pre-line; }
	.tools { display: flex; flex-wrap: wrap; column-gap: 16px; }
	.tools > * { pointer-events: auto; }
	.hud button { -webkit-tap-highlight-color: transparent; }
	.tools button[aria-pressed='true'] { color: var(--ink); }
	.tools button { min-height: 44px; color: var(--soft); font: 300 10px/1.5 var(--mono); letter-spacing: 0.15em; text-transform: uppercase; }
	.hud[data-mode='live'][data-opening] .golive { display: inline-block; }
	@media (max-width: 640px) {
		.storm { top: auto; bottom: calc(var(--gut) + 128px); flex-direction: column-reverse; }
	}
	.hud {
		--ink: rgb(238 242 247 / 0.9);
		--soft: rgb(238 242 247 / 0.62);
		--dim: rgb(238 242 247 / 0.4);
		--hair: rgb(238 242 247 / 0.14);
		--glow: #f3e7cc;
		--shade: rgb(0 0 0 / 0.55);
		--mono: 'IBM Plex Mono', ui-monospace, monospace;
		--sans: 'IBM Plex Sans', system-ui, sans-serif;
		--gut: clamp(18px, 2.6vw, 40px);
		color: var(--ink);
		font: 300 14px/1.6 var(--sans);
		-webkit-font-smoothing: antialiased;
		text-shadow: 0 0 14px var(--shade);
	}
	.hud p {
		margin: 0;
	}
	button,
	summary {
		font: inherit;
		color: inherit;
		text-shadow: inherit;
	}
	button {
		padding: 0;
		background: none;
		border: 0;
		cursor: pointer;
	}
	a,
	button,
	summary {
		transition:
			color 0.6s ease,
			opacity 0.6s ease;
	}
	:focus-visible {
		outline: 1px solid var(--soft);
		outline-offset: 5px;
	}
	.cap {
		color: var(--dim);
		font: 300 10px/1 var(--mono);
		letter-spacing: 0.24em;
		text-transform: uppercase;
	}
	[hidden] {
		display: none !important;
	}
	.hud[data-mode='live'] .golive {
		display: none;
	}

	.frame {
		position: fixed;
		inset: 12px;
		pointer-events: none;
	}
	.frame i {
		position: absolute;
		width: 34px;
		height: 34px;
		border: 0 solid var(--hair);
	}
	.frame i:nth-child(1) {
		top: 0;
		left: 0;
		border-width: 1px 0 0 1px;
	}
	.frame i:nth-child(2) {
		top: 0;
		right: 0;
		border-width: 1px 1px 0 0;
	}
	.frame i:nth-child(3) {
		bottom: 0;
		left: 0;
		border-width: 0 0 1px 1px;
	}
	.frame i:nth-child(4) {
		right: 0;
		bottom: 0;
		border-width: 0 1px 1px 0;
	}

	.id {
		position: fixed;
		top: var(--gut);
		left: var(--gut);
	}
	h1 {
		margin: 0;
		color: var(--ink);
		font: 200 18px/1 var(--sans);
		letter-spacing: 0.5em;
		text-transform: uppercase;
	}
	.id .tag {
		margin-top: 10px;
	}

	.clock {
		position: fixed;
		top: var(--gut);
		right: var(--gut);
		text-align: right;
	}
	.clock .t {
		display: flex;
		gap: 12px;
		justify-content: flex-end;
		font: 200 40px/1 var(--mono);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
	}
	.clock .side {
		display: grid;
		align-content: space-between;
		padding: 5px 0 4px;
		text-align: left;
	}
	.clock .t small {
		color: var(--dim);
		font: 300 10px/1 var(--mono);
		letter-spacing: 0.24em;
	}
	.clock .d {
		color: var(--soft);
		font: 300 11px/1 var(--mono);
		letter-spacing: 0.14em;
		white-space: nowrap;
	}
	.state {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		margin-top: 14px;
	}
	.state .cap {
		color: var(--soft);
	}
	.state .rate {
		margin-left: 6px;
		font-variant-numeric: tabular-nums;
		transition: opacity 0.35s ease;
	}
	.rate[data-fade] {
		opacity: 0;
	}
	.pulse {
		width: 5px;
		height: 5px;
		background: var(--ink);
		border-radius: 50%;
		box-shadow: 0 0 10px rgb(255 255 255 / 0.8);
		animation: breathe 3.2s ease-in-out infinite;
	}
	.hud[data-mode='replay'] .pulse {
		opacity: 0.5;
		box-shadow: none;
		animation: none;
	}
	@keyframes breathe {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
	}
	.hud[data-late] .pulse {
		opacity: 0.4;
		box-shadow: none;
		animation: none;
	}
	.sources {
		display: grid;
		gap: 6px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
		color: var(--dim);
		font: 300 9.5px/1 var(--mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.sources :global(li[data-state='delayed']),
	.sources :global(li[data-state='offline']) {
		color: var(--soft);
	}
	.sources :global(li[data-state='live']),
	.hud[data-late] :is(.sources, .note) {
		display: none;
	}
	.note {
		margin-top: 8px;
		color: var(--dim);
		font: 300 11px/1.4 var(--sans);
		font-style: italic;
	}
	.stale {
		position: fixed;
		top: var(--gut);
		left: 50%;
		max-width: calc(100vw - 2 * var(--gut) - 360px);
		color: var(--soft);
		text-align: center;
		transform: translateX(-50%);
	}
	.stale .dots {
		display: none;
	}
	.stale[data-loading] .dots {
		display: inline;
	}
	.dots i {
		font-style: normal;
		animation: dot 1.8s ease-in-out infinite;
	}
	.dots i:nth-child(2) {
		animation-delay: 0.3s;
	}
	.dots i:nth-child(3) {
		animation-delay: 0.6s;
	}
	@keyframes dot {
		0%,
		100% {
			opacity: 0.2;
		}
		40% {
			opacity: 1;
		}
	}
	.golive {
		margin-left: 6px;
		padding-bottom: 3px;
		color: var(--soft);
		font: 300 10px/1 var(--mono);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--hair);
	}
	.golive:hover {
		color: var(--ink);
	}

	.layers {
		position: fixed;
		top: calc(var(--gut) + 150px);
		right: var(--gut);
		display: grid;
		gap: 14px;
		justify-items: end;
	}
	.sw {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		min-height: 24px;
		color: var(--dim);
	}
	.sw .cap {
		color: inherit;
	}
	.sw i {
		width: 4px;
		height: 4px;
		border: 1px solid var(--dim);
		border-radius: 50%;
	}
	.sw[aria-pressed='true'] {
		color: var(--ink);
	}
	.sw[aria-pressed='true'] i {
		background: var(--ink);
		border-color: var(--ink);
	}
	.sw:hover {
		color: var(--soft);
	}
	.group {
		display: grid;
		gap: 14px;
		justify-items: end;
	}
	.mix {
		display: grid;
		gap: 4px;
		justify-items: end;
		margin-top: -6px;
	}
	.level {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		min-height: 24px;
		cursor: pointer;
	}
	.level input {
		width: 84px;
		height: 24px;
		margin: 0;
		background: none;
		cursor: pointer;
		appearance: none;
	}
	.level input::-webkit-slider-runnable-track {
		height: 1px;
		background: var(--soft);
	}
	.level input::-moz-range-track {
		height: 1px;
		background: var(--soft);
	}
	.level input::-webkit-slider-thumb {
		width: 9px;
		height: 9px;
		margin-top: -4px;
		background: var(--ink);
		border: 0;
		border-radius: 50%;
		appearance: none;
	}
	.level input::-moz-range-thumb {
		width: 9px;
		height: 9px;
		background: var(--ink);
		border: 0;
		border-radius: 50%;
	}
	.afterglow {
		display: grid;
		gap: 6px;
		justify-items: end;
	}
	.opts {
		display: flex;
		gap: 12px;
		align-items: baseline;
	}
	.opts :global(button) {
		min-width: 14px;
		min-height: 24px;
		padding: 0 0 4px;
		color: var(--dim);
		font: 300 11px/1 var(--mono);
		font-variant-numeric: tabular-nums;
		text-shadow: inherit;
		cursor: pointer;
		background: none;
		border: 0;
		border-bottom: 1px solid transparent;
		transition: color 0.6s ease;
	}
	.opts :global(button:hover) {
		color: var(--soft);
	}
	.opts :global(button[aria-checked='true']) {
		color: var(--ink);
		border-bottom-color: var(--soft);
	}
	.opts :global(button:disabled) {
		cursor: default;
	}
	.opts :global(button:disabled:not([aria-checked='true']):hover) {
		color: var(--dim);
	}
	.opts :global(small) {
		color: var(--dim);
		font: 300 9.5px/1 var(--mono);
		letter-spacing: 0.14em;
	}

	.corner {
		position: fixed;
		right: var(--gut);
		bottom: var(--gut);
		z-index: 2;
		display: flex;
		gap: 28px;
		align-items: center;
	}
	.hud[data-mode='replay'] .corner {
		bottom: calc(var(--gut) + 64px);
	}
	.corner .cap {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		color: var(--dim);
		font-size: 9.5px;
		text-decoration: none;
		cursor: pointer;
	}
	.corner .cap:hover {
		color: var(--soft);
	}

	/* No WebGL: the text goes back in flow, above the fallback image. */
	:global(body:has([data-globe-fallback]:not([hidden]))) .hud :is(.id, .corner, .clock) {
		position: static;
		width: auto;
		margin: var(--gut);
		text-align: left;
	}
	:global(body:has([data-globe-fallback]:not([hidden]))) .corner {
		display: grid;
		justify-items: start;
	}
	:global(body:has([data-globe-fallback]:not([hidden]))) .frame {
		display: none;
	}

	@media (max-width: 640px) {
		.hud {
			--gut: 18px;
		}
		.frame {
			inset: 8px;
		}
		.frame i {
			width: 22px;
			height: 22px;
		}
		h1 {
			font-size: 14px;
			letter-spacing: 0.42em;
		}
		.id .tag {
			display: none;
		}
		.clock .t {
			font-size: 24px;
		}
		.clock .t {
			gap: 6px;
		}
		.clock .side {
			padding: 2px 0 1px;
		}
		.clock .t small {
			font-size: 8px;
		}
		.clock .d {
			font-size: 9px;
			letter-spacing: 0.1em;
		}
		.layers {
			top: calc(var(--gut) + 112px);
		}
		.hud:has(.sources:not([hidden]) :global(li:not([data-state='live']))) .layers {
			top: calc(var(--gut) + 150px);
		}
		.stale {
			top: auto;
			bottom: calc(var(--gut) + 96px);
			max-width: calc(100vw - 2 * var(--gut));
		}
		.corner {
			bottom: calc(var(--gut) + 40px);
			gap: 22px;
		}
		.hud[data-mode='replay'] .corner {
			bottom: calc(var(--gut) + 96px);
		}
	}
	@media (max-width: 359px) {
		.clock .t {
			flex-direction: column;
			align-items: flex-end;
		}
		.clock .side {
			display: flex;
			gap: 8px;
			padding: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pulse,
		.dots i {
			animation: none;
		}
		.state .rate {
			transition: none;
		}
		a,
		button,
		summary {
			transition: none;
		}
	}
</style>

<script>
	import type { GlobeApp } from '../globe/app';
	import { GLOBE_FALLBACK, GLOBE_GONE, GLOBE_READY } from '../globe/island';
	import { DISPLAY_MINUTES } from '../globe/lightning/display';
	import { trackCaption } from '../globe/replay/track';
	import { feedLabel, formatAge, SOURCE_REGIONS, sourcesNote } from '../globe/live/freshness';
	import { trackObservation } from '../globe/scene-time';
	import { flashRate, rateLabel } from './hud/rate';
	import { endedCaption, formatDate, formatTime, liveCaption, positionCaption, zoneLabel } from './hud/format';
	import { LEVELS_KEY, levelKey, savedLevels } from './hud/levels';

	const root = document.querySelector<HTMLElement>('[data-hud]');
	if (root) {
		const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector);
		const time = $<HTMLTimeElement>('[data-time]');
		const date = $('[data-date]');
		const zone = $('[data-zone]');
		const state = $('[data-state]');
		const layers = $('[data-layers]');
		const clouds = $<HTMLButtonElement>('[data-clouds]');
		const sound = $<HTMLButtonElement>('[data-sound]');
		const mix = $('[data-mix]');
		const levelInputs = [...root.querySelectorAll<HTMLInputElement>('[data-level]')];
		const sources = $('[data-sources]');
		const sourcesNoteLine = $('[data-sources-note]');
		const staleBanner = $('[data-stale]');
		const rate = $('[data-rate]');
		const staleText = $('[data-stale-text]');
		const replayStatus = $('[data-replay-status]');
		const stormTools = $('[data-storm-tools]');
		const horizon = $<HTMLButtonElement>('[data-horizon]');
		const follow = $<HTMLButtonElement>('[data-follow]');
		const globe = $<HTMLButtonElement>('[data-globe]');
		const restart = $<HTMLButtonElement>('[data-restart]');
		const display = $('[data-display]');
		const afterglow = $('[data-afterglow]');
		let app: GlobeApp | undefined;
		let fallback = false;
		let trackTimes: { detail: unknown; times: number[] } = { detail: null, times: [] };

		const showFreshness = (live: boolean, replayLabel: string) => {
			const status = live && app ? app.feedStatus() : undefined;
			const starting = live && !app && !fallback;
			const label = status
				? feedLabel(status)
				: starting
					? { state: 'Connecting', banner: 'Acquiring satellite data', loading: true }
					: { state: live ? 'Live' : replayLabel, banner: '' };
			root.toggleAttribute('data-late', Boolean(status?.stale));
			if (state && state.textContent !== label.state) state.textContent = label.state;
			if (staleBanner) {
				staleBanner.hidden = !label.banner;
				staleBanner.toggleAttribute('data-loading', Boolean(label.loading));
				if (staleText && staleText.textContent !== label.banner) staleText.textContent = label.banner;
			}
			if (sources) {
				const lines = (status?.sources ?? []).map((s) => ({
					state: s.state,
					text: [SOURCE_REGIONS[s.source] ?? s.label, s.state === 'live' ? null : s.state, s.ageMs === null ? null : formatAge(s.ageMs)]
						.filter(Boolean)
						.join(' · '),
				}));
				sources.hidden = lines.length === 0;
				const html = lines.map((l) => `<li data-state="${l.state}">${l.text}</li>`).join('');
				if (sources.innerHTML !== html) sources.innerHTML = html;
			}
			if (sourcesNoteLine) {
				const note = sourcesNote(status?.sources ?? []);
				sourcesNoteLine.hidden = !note;
				if (sourcesNoteLine.textContent !== note) sourcesNoteLine.textContent = note;
			}
		};

		const rateShown = () => Boolean(app && app.clock.mode === 'live' && !app.feedStatus().stale);
		let rateText = '';
		const updateRate = () => {
			if (!rate) return;
			const text = app && rateShown() ? rateLabel(flashRate(app.debug.ring, app.debug.delays(), app.clock.time())) : '';
			if (text === rateText && rate.hidden === !text) return;
			rateText = text;
			if (!text) {
				rate.hidden = true;
				return;
			}
			if (rate.hidden) {
				rate.textContent = text;
				rate.dataset.fade = '';
				rate.hidden = false;
				requestAnimationFrame(() => requestAnimationFrame(() => delete rate.dataset.fade));
				return;
			}
			rate.dataset.fade = '';
			setTimeout(() => {
				rate.textContent = rateText;
				delete rate.dataset.fade;
			}, 350);
		};
		setInterval(updateRate, 5000);

		const tick = () => {
			const replay = app?.replay.state;
			const live = app?.focus.status().live ?? null;
			const opened = Boolean(replay?.selected && !replay.loading && app?.clock.mode === 'replay');
			if (stormTools) stormTools.hidden = !opened && !live;
			if (globe) globe.hidden = !live;
			if (restart) restart.hidden = !app?.replay.ended;
			follow?.setAttribute('aria-pressed', String(app?.focus.following ?? false));
			horizon?.setAttribute('aria-pressed', String(app?.focus.horizon ?? false));
			root.toggleAttribute('data-opening', Boolean(replay?.loading || replay?.error));
			if (replayStatus) {
				const selected = replay?.selected;
				if (selected && trackTimes.detail !== selected) {
					trackTimes = { detail: selected, times: selected.track.map((p) => Date.parse(p.time)).sort((a, b) => a - b) };
				}
				const observed = app?.observedTime() ?? 0;
				const position = selected && !replay.loading
					? positionCaption(trackObservation(trackTimes.times, observed), observed)
					: '';
				const ended = selected && !replay.loading ? endedCaption(selected.storm, observed) : '';
				const caption = replay?.loading ? 'Opening storm replay…' : replay?.error ?? (selected
					? [`${selected.storm.label} · ${trackCaption(selected)}`, position, ended].filter(Boolean).join('\n')
					: app ? liveCaption(app.focus.status(), app.clock.wallTime()).join('\n') : '');
				replayStatus.hidden = !caption;
				if (replayStatus.textContent !== caption) replayStatus.textContent = caption;
			}
			const now = app?.clock.time() ?? Date.now();
			const text = formatTime(now);
			if (time && time.textContent !== text) {
				time.textContent = text;
				time.dateTime = new Date(now).toISOString();
			}
			const day = formatDate(now);
			if (date && date.textContent !== day) date.textContent = day;
			const place = zoneLabel(undefined, now);
			if (zone && zone.textContent !== place) zone.textContent = place;
			const mode = app?.clock.mode === 'live' || !app ? 'live' : 'replay';
			if (root.dataset.mode !== mode) root.dataset.mode = mode;
			showFreshness(mode === 'live', app?.hasData(now) ? 'Replay' : 'Replay · no data');
			if (rate && rate.hidden === rateShown()) updateRate();
			clouds?.setAttribute('aria-pressed', String(app?.clouds.visible ?? false));
			sound?.setAttribute('aria-pressed', String(app?.sound.enabled ?? false));
			if (mix) mix.hidden = !app?.sound.enabled;
			const stormView = app?.lightning.stormView ?? false;
			if (afterglow) afterglow.title = stormView ? 'Storm views show each flash alone' : '';
			for (const { minutes, button } of displayButtons) {
				const checked = (stormView ? 0 : app?.lightning.displayMinutes) === minutes;
				button.setAttribute('aria-checked', String(checked));
				button.disabled = stormView;
				button.tabIndex = checked ? 0 : -1;
			}
		};

		const chooseDisplay = (index: number) => {
			if (app?.lightning.stormView) return;
			const choice = displayButtons[(index + displayButtons.length) % displayButtons.length];
			app?.lightning.setDisplayMinutes(choice.minutes);
			tick();
			choice.button.focus();
		};
		const displayButtons = DISPLAY_MINUTES.map((minutes, index) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.setAttribute('role', 'radio');
			button.setAttribute('aria-label', minutes === 0 ? 'No afterglow' : `${minutes} ${minutes === 1 ? 'minute' : 'minutes'}`);
			button.textContent = String(minutes);
			button.addEventListener('click', () => chooseDisplay(index));
			button.addEventListener('keydown', (event) => {
				const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
				if (!step) return;
				event.preventDefault();
				chooseDisplay(index + step);
			});
			display?.append(button);
			return { minutes, button };
		});
		const unit = document.createElement('small');
		unit.setAttribute('aria-hidden', 'true');
		unit.textContent = 'MIN';
		display?.append(unit);
		tick();
		setInterval(tick, 250);

		window.addEventListener(GLOBE_READY, (event) => {
			app = (event as CustomEvent<GlobeApp>).detail;
			if (layers) layers.hidden = false;
			if (sound) sound.hidden = !app.sound.supported;
			app.sound.setLevels(savedLevels());
			for (const input of levelInputs) input.value = String(Math.round(app.sound.levels[levelKey(input)] * 100));
			tick();
		});
		window.addEventListener(GLOBE_GONE, () => {
			app = undefined;
			if (layers) layers.hidden = true;
		});
		window.addEventListener(GLOBE_FALLBACK, () => {
			fallback = true;
		});
		$('[data-live]')?.addEventListener('click', () => {
			void app?.replay.live();
			tick();
		});
		horizon?.addEventListener('click', () => {
			if (!app) return;
			void app.focus.setHorizon(!app.focus.horizon);
			tick();
		});
		follow?.addEventListener('click', () => {
			if (!app) return;
			app.focus.setFollow(!app.focus.following);
			tick();
		});
		globe?.addEventListener('click', () => {
			app?.focus.globe();
			tick();
		});
		restart?.addEventListener('click', () => {
			app?.replay.restart();
			tick();
		});
		clouds?.addEventListener('click', () => {
			if (app) app.clouds.setVisible(!app.clouds.visible);
			tick();
		});
		sound?.addEventListener('click', () => {
			if (app) app.sound.setEnabled(!app.sound.enabled);
			tick();
		});
		for (const input of levelInputs) {
			input.addEventListener('input', () => {
				if (!app) return;
				app.sound.setLevels({ [levelKey(input)]: Number(input.value) / 100 });
				try {
					localStorage.setItem(LEVELS_KEY, JSON.stringify(app.sound.levels));
				} catch {
					// Private mode: the levels last for the page only.
				}
			});
		}
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			if (!app || document.querySelector('[data-storm-suggestions][open]')) return;
			if (app.focus.following) app.focus.setFollow(false);
			else if (app.focus.live) app.focus.globe();
			tick();
		});
	}
</script>
