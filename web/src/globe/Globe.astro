<canvas class="globe-canvas" data-globe-canvas aria-hidden="true"></canvas>
<div class="coverage-label" role="tooltip" data-coverage-label hidden>No satellite lightning coverage</div>
<figure class="globe-fallback" data-globe-fallback hidden>
	<img src="/globe-fallback.svg" alt="Illustration of the Earth" width="240" height="240" loading="lazy" decoding="async" />
	<figcaption>The 3D globe needs WebGL 2, which is not available in this browser.</figcaption>
</figure>

<style>
	.globe-canvas {
		position: fixed;
		inset: 0;
		z-index: -1;
		display: block;
		width: 100vw;
		height: 100vh;
	}
	.globe-canvas[hidden],
	.globe-fallback[hidden],
	.coverage-label[hidden] {
		display: none;
	}
	.coverage-label {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 2;
		max-width: min(280px, calc(100vw - 16px));
		padding: 10px 12px;
		color: rgb(238 242 247 / 0.9);
		font: 300 13px/1.4 'IBM Plex Sans', system-ui, sans-serif;
		pointer-events: none;
		background: rgb(8 10 14 / 0.72);
		border: 1px solid rgb(238 242 247 / 0.14);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}
	.globe-fallback {
		margin: 2rem 0;
	}
	.globe-fallback img {
		display: block;
		max-width: 100%;
		height: auto;
	}
</style>

<script>
	import { mountGlobeIsland } from './island';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-globe-canvas]');
	const fallback = document.querySelector<HTMLElement>('[data-globe-fallback]');
	const coverageLabel = document.querySelector<HTMLElement>('[data-coverage-label]') ?? undefined;
	if (canvas && fallback) mountGlobeIsland({ canvas, fallback, coverageLabel });
</script>
