<canvas class="globe-canvas" data-globe-canvas aria-hidden="true"></canvas>
<div class="coverage-label" role="tooltip" data-coverage-label data-kind="gap" hidden><span class="gap">No satellite lightning coverage</span><span class="storms">Storms seen by Himawari<small>Cold cloud tops, hourly. No lightning feed here.</small></span></div>
<div class="cyclone-labels" data-cyclone-labels aria-hidden="true"></div>
<figure class="globe-fallback" data-globe-fallback hidden>
	<img src="/globe-fallback.svg" alt="Illustration of the Earth" width="240" height="240" loading="lazy" decoding="async" />
	<figcaption>The 3D globe needs WebGL 2, which is not available in this browser.</figcaption>
</figure>

<style>
	.globe-canvas {
		position: fixed;
		inset: 0;
		z-index: -1;
		display: block;
		width: 100vw;
		height: 100vh;
	}
	.globe-canvas[hidden],
	.globe-fallback[hidden],
	.coverage-label[hidden] {
		display: none;
	}
	.coverage-label[data-kind='gap'] .storms,
	.coverage-label[data-kind='storms'] .gap {
		display: none;
	}
	.coverage-label small {
		display: block;
		font-size: 12px;
		color: rgb(238 242 247 / 0.6);
	}
	.coverage-label {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 2;
		max-width: min(280px, calc(100vw - 16px));
		padding: 10px 12px;
		color: rgb(238 242 247 / 0.9);
		font: 300 13px/1.4 'IBM Plex Sans', system-ui, sans-serif;
		pointer-events: none;
		background: rgb(8 10 14 / 0.72);
		border: 1px solid rgb(238 242 247 / 0.14);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}
	.cyclone-labels {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.cyclone-labels :global(.cyclone) {
		position: absolute;
		top: 0;
		left: 0;
		margin: 0;
		color: rgb(238 242 247 / calc(0.72 + 0.2 * var(--day, 0)));
		font: 300 11px/1.35 'IBM Plex Sans', system-ui, sans-serif;
		white-space: nowrap;
		text-shadow: 0 0 1px rgb(4 8 18 / var(--day, 0)), 0 0 3px rgb(4 8 18 / calc(0.6 + 0.4 * var(--day, 0))), 0 0 7px rgb(4 8 18 / var(--day, 0)), 0 0 16px rgb(4 8 18 / calc(0.5 + 0.4 * var(--day, 0)));
	}
	.cyclone-labels :global(.cyclone[hidden]) {
		display: none;
	}
	.cyclone-labels :global(.cyclone b) {
		display: block;
		color: rgb(238 242 247 / 0.95);
		font: 300 10px/1.5 'IBM Plex Mono', ui-monospace, monospace;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}
	.globe-fallback {
		margin: 2rem 0;
	}
	.globe-fallback img {
		display: block;
		max-width: 100%;
		height: auto;
	}
</style>

<script>
	import { mountGlobeIsland } from './island';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-globe-canvas]');
	const fallback = document.querySelector<HTMLElement>('[data-globe-fallback]');
	const coverageLabel = document.querySelector<HTMLElement>('[data-coverage-label]') ?? undefined;
	const cycloneLabels = document.querySelector<HTMLElement>('[data-cyclone-labels]') ?? undefined;
	if (canvas && fallback) mountGlobeIsland({ canvas, fallback, coverageLabel, cycloneLabels });
</script>
