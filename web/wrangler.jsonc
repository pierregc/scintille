// Deployment: docs/deploy.md. Hosting decision: docs/adr/0005-hosting-and-dynamic-pages.md.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "scintille",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": false
	},
	"routes": [{ "pattern": "scintille.app", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true,
	"cache": { "enabled": false },
	"r2_buckets": [{ "binding": "LIVE", "bucket_name": "scintille-live" }],
	"d1_databases": [{ "binding": "SEARCH", "database_name": "scintille-search", "database_id": "a987885c-c381-4030-947e-3209276a32bf" }],
	"previews": {
		"r2_buckets": [{ "binding": "LIVE", "bucket_name": "scintille-live-preview" }],
		"d1_databases": [{ "binding": "SEARCH", "database_name": "scintille-search-preview", "database_id": "32d93d6e-91b0-437b-9b01-ff1550cbdb53" }]
	}
}
